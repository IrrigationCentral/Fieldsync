rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Is the user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the current user's role from their profile
    // NOTE: This costs 1 read per rule evaluation
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Role checks
    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isOffice() {
      return isAuthenticated() && getUserRole() == 'office';
    }

    function isTech() {
      return isAuthenticated() && getUserRole() == 'tech';
    }

    function isFarmer() {
      return isAuthenticated() && getUserRole() == 'farmer';
    }

    // Combined role checks
    function isOfficeOrManager() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'office' || role == 'manager');
    }

    function isStaff() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'tech' || role == 'office' || role == 'manager');
    }

    // ============================================
    // SETTINGS COLLECTION
    // ============================================
    match /settings/{document} {
      // Staff can read settings (pricing, etc)
      allow read: if isStaff();

      // Only managers can modify settings
      allow write: if isManager();
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // All authenticated users can read profiles
      // (needed for job assignments, contact info, etc)
      allow read: if isAuthenticated();

      // Users can create their own profile during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own profile EXCEPT role field
      // Managers can update anyone including role changes
      allow update: if isAuthenticated() && (
        // Own profile, but not changing role
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role)
        ||
        // Manager can change anything
        isManager()
      );

      // Only managers can delete users
      allow delete: if isManager();
    }

    // ============================================
    // PIVOTS (EQUIPMENT) COLLECTION
    // ============================================
    match /pivots/{pivotId} {
      // Staff can read all equipment
      // Farmers can only read their own equipment
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);

      // Staff can create equipment
      // Farmers can create equipment for themselves
      allow create: if isStaff() ||
        (isAuthenticated() && request.resource.data.farmerId == request.auth.uid);

      // Staff can update any equipment
      // Farmers can update their own equipment
      allow update: if isStaff() ||
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);

      // Only office/manager can delete equipment
      allow delete: if isOfficeOrManager();
    }

    // ============================================
    // JOBS COLLECTION
    // ============================================
    match /jobs/{jobId} {
      // Staff can read all jobs
      // Farmers can read jobs for their equipment
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.farmerId == request.auth.uid);

      // Only staff can create jobs
      allow create: if isStaff();

      // Staff can update any job
      // Farmers can only update rating/feedback fields on their jobs
      allow update: if isStaff() ||
        (isAuthenticated() &&
         resource.data.farmerId == request.auth.uid &&
         // Only allow updating these specific fields
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['rating', 'feedback', 'updatedAt']));

      // Only office/manager can delete jobs
      allow delete: if isOfficeOrManager();
    }

    // ============================================
    // PARTS COLLECTION
    // ============================================
    match /parts/{partId} {
      // All authenticated users can read parts
      // (needed for job completion forms)
      allow read: if isAuthenticated();

      // Only office/manager can manage parts inventory
      allow create, update, delete: if isOfficeOrManager();
    }

    // ============================================
    // CATCH-ALL: DENY EVERYTHING ELSE
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
